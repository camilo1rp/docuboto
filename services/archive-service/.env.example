DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
REDIS_URL=redis://redis:6379/0
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=orpycamcp

# D-02 (remediación no-read-up en anexos, RF-SEG-08): secreto compartido con
# storage-service.INTERNAL_SERVICE_TOKEN, enviado en X-Internal-Token al
# descargar el índice ya firmado (app/clients/storage_client.py). Vacío =
# storage-service rechaza con 401.
STORAGE_INTERNAL_TOKEN=

# E10 debt (cableado del AIP OAIS al cierre del expediente): resolución
# cross-servicio de los file_id de los anexos de un lote de radicados —
# app/clients/document_client.py. Secreto compartido con
# document-service.INTERNAL_SERVICE_TOKEN. Vacío = document-service rechaza
# con 401.
DOCUMENT_SERVICE_URL=http://document-service:8003
DOCUMENT_INTERNAL_TOKEN=
