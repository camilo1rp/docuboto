DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
SERVICE_PORT=8011
LOG_LEVEL=info

# Proveedor de embeddings (ADR-006/E21 Inc.1: pluggable).
# 'local_st'  = sentence-transformers EN el contenedor (default de despliegue;
#               soberano, el texto nunca sale a un tercero). Descarga ~400MB
#               la primera vez que arranca (carga lazy, ver app/main.py).
# 'stub'      = embeddings deterministas sin modelo, sin descarga. Fallback de
#               test/dev (los tests FUERZAN este valor, ver tests/conftest.py).
# 'ollama'    = MÍNIMO VIABLE vía HTTP a OLLAMA_URL; no hay Ollama provisionado
#               en docker-compose.yml de este repo (requiere despliegue aparte).
EMBEDDING_PROVIDER=local_st
# Fuente ÚNICA de la dimensión de knowledge_chunk.embedding (migración 007).
# El proveedor configurado DEBE producir exactamente esta dimensión o el
# arranque aborta (guard fail-closed, app/main.py::lifespan).
EMBEDDING_DIM=384
# Modelo del proveedor real. Para 'local_st': nombre de modelo de
# sentence-transformers (multilingüe, 384 dim por defecto). Para 'ollama': el
# tag servido por esa instancia (sobreescribir si se usa 'ollama').
MODEL_EMBED=paraphrase-multilingual-MiniLM-L12-v2
# Solo relevante si EMBEDDING_PROVIDER=ollama.
OLLAMA_URL=http://ollama:11434

# Token de servicio interno (D-02 / RF-SEG-08): cadena aleatoria compartida que deben
# incluir los servicios internos (document-service, archive-service…) en el header
# X-Internal-Token al llamar a /api/v1/knowledge/ingest.
# Si se deja vacío, el endpoint rechaza TODAS las peticiones (fail-closed).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_TOKEN=
