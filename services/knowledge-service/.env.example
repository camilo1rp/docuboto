DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
SERVICE_PORT=8011
LOG_LEVEL=info

# Proveedor de embeddings (ADR-006: pluggable, local por defecto).
# 'stub' = embeddings deterministas sin modelo externo. Un proveedor real
# (p. ej. sentence-transformers o una API) se conecta cambiando este valor.
EMBEDDING_PROVIDER=stub
EMBEDDING_DIM=64

# Token de servicio interno (D-02 / RF-SEG-08): cadena aleatoria compartida que deben
# incluir los servicios internos (document-service, archive-service…) en el header
# X-Internal-Token al llamar a /api/v1/knowledge/ingest.
# Si se deja vacío, el endpoint rechaza TODAS las peticiones (fail-closed).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_TOKEN=
