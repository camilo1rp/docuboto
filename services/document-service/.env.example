DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
REDIS_URL=redis://redis:6379/0
STORAGE_SERVICE_URL=http://storage-service:8005
# D-02: secreto compartido con storage-service.INTERNAL_SERVICE_TOKEN,
# enviado en X-Internal-Token al pedir bytes de un anexo (mediación de
# descarga, RF-SEG-08). Vacío = storage-service rechaza con 401.
STORAGE_INTERNAL_TOKEN=
TENANT_SERVICE_URL=http://tenant-service:8002
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=orpycamcp
SERVICE_PORT=8003
LOG_LEVEL=info

# Ingesta de correo (E19). Dejar IMAP_HOST vacío para deshabilitarla.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX
