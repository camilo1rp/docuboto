DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
REDIS_URL=redis://redis:6379/0
STORAGE_SERVICE_URL=http://storage-service:8005
# D-02: secreto compartido con storage-service.INTERNAL_SERVICE_TOKEN,
# enviado en X-Internal-Token al pedir bytes de un anexo (mediación de
# descarga, RF-SEG-08). Vacío = storage-service rechaza con 401.
STORAGE_INTERNAL_TOKEN=
# D-02 (E10 debt, cableado del AIP al cierre): secreto que ESTE servicio
# exige en X-Internal-Token en POST /api/v1/internal/documentos/anexos.
# Único llamador legítimo: archive-service. Vacío = este servicio rechaza
# con 401 (fail-closed).
INTERNAL_SERVICE_TOKEN=
TENANT_SERVICE_URL=http://tenant-service:8002
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=orpycamcp
SERVICE_PORT=8003
LOG_LEVEL=info

# Ingesta de correo (E19). No hay variables de buzón: las cuentas se configuran
# desde /admin/correo y viven en `email_cuenta`, con la credencial cifrada con
# EMAIL_ENCRYPTION_KEY. Las antiguas IMAP_* están retiradas.
EMAIL_ENCRYPTION_KEY=
# Sondeo programado de las cuentas en modo automático. Apagado por defecto, y
# sin entidad declarada no arranca.
EMAIL_SONDEO_ENABLED=false
EMAIL_SONDEO_TENANT_SLUG=
