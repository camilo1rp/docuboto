DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=orpycamcp
MINIO_SECRET_KEY=orpycamcp_dev
MINIO_USE_SSL=false
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=orpycamcp
PRESIGNED_URL_EXPIRY=3600
SERVICE_PORT=8005
LOG_LEVEL=info

# D-02 (remediación no-read-up en anexos, RF-SEG-08): secreto exigido en
# X-Internal-Token por los endpoints que sirven bytes/URL/metadata de un
# archivo (download presigned, content, metadata). /upload NO lo exige.
# Vacío (default) = fail-closed: TODAS las llamadas a esos endpoints se
# rechazan con 401. Mismo valor que STORAGE_INTERNAL_TOKEN en
# document/archive/signature-service. NUNCA commitees el valor real.
INTERNAL_SERVICE_TOKEN=

# Entorno de despliegue ("development" | "production"). Gatea el guard de
# arranque de preservación WORM (ver PRESERVATION_RETENTION_MODE abajo).
APP_ENV=development

# Preservación WORM del índice electrónico firmado (E10 Increment A).
# Feature flag/kill-switch: con false, POST /preservacion/proteger-indice responde 503.
PRESERVATION_ENABLED=false
PRESERVATION_BUCKET_SUFFIX=preservation
# COMPLIANCE (recomendado en producción) | GOVERNANCE (solo necesidad operativa
# explícita — en APP_ENV=production con GOVERNANCE el servicio rechaza el arranque).
PRESERVATION_RETENTION_MODE=COMPLIANCE
PRESERVATION_MIN_RETENTION_DAYS=365
PRESERVATION_MAX_RETENTION_YEARS=100
