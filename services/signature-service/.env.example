DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
SERVICE_PORT=8008
LOG_LEVEL=info

# Proveedor de firma (ADR-016: pluggable).
# 'nativa' = firma electrónica (hash + identidad). Un proveedor PKI
# XAdES/PAdES/TSA real se conecta cambiando este valor.
SIGNER_PROVIDER=nativa

# Secreto HMAC del servicio (RF-FIR-12, D-01).
# Hace que la firma_blob NO sea reproducible desde fuera aunque el payload y
# firmante_id sean públicos. Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA commitees el valor real. Rotar requiere re-firmar documentos existentes.
SIGNATURE_SECRET=change-me-in-production

# Keycloak — validación JWT local (RF-FIR-11, D-01).
# El firmante se deriva SIEMPRE del token validado, nunca de headers ni del body.
KEYCLOAK_URL=http://keycloak:8180
KEYCLOAK_REALM=orpycamcp
JWKS_CACHE_TTL=300
