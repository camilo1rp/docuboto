DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@postgres:5432/orpycamcp_db
SERVICE_PORT=8008
LOG_LEVEL=info
REDIS_URL=redis://redis:6379/0

# Proveedor de firma (ADR-016: pluggable).
# 'xades_local' = XAdES-B real con el sello institucional del tenant, SOLO
# para objeto_tipo='indice' (ver app/routers/signature.py::_select_provider_name).
# Cualquier otro objeto_tipo cae siempre a 'nativa' (HMAC de servicio).
# Fijar aquí 'nativa' es el kill-switch operativo: deshabilita XAdES por
# completo (también para índices) sin tocar código.
SIGNER_PROVIDER=xades_local

# Secreto HMAC del servicio (RF-FIR-12, D-01) — proveedor 'nativa'.
# Hace que la firma_blob NO sea reproducible desde fuera aunque el payload y
# firmante_id sean públicos. Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA commitees el valor real. Rotar requiere re-firmar documentos existentes.
SIGNATURE_SECRET=change-me-in-production

# Sello institucional XAdES-B (RT-16, Inc.1) — proveedor 'xades_local'.
# Directorio raíz con un subdirectorio por tenant: <dir>/<slug>/seal.{crt,key}.
# Genera un par de DESARROLLO (no acreditado) con:
#   ./scripts/gen-dev-signing-cert.sh          # fallback _dev/, cubre todos los tenants
#   ./scripts/gen-dev-signing-cert.sh <slug>   # sello propio de un tenant
SIGNER_CERT_DIR=/run/secrets/signing
# Passphrase opcional de la clave privada del sello (vacío = sin cifrar).
SIGNER_KEY_PASSWORD=
# Kill-switch del fallback de sello compartido _dev/ (default: false).
# Solo en desarrollo: true, para firmar con el par compartido cuando un
# tenant no tiene sello propio montado. NUNCA true en producción — deja
# `load_seal` fallar cerrado (503) en vez de compartir la clave entre tenants.
SIGNER_ALLOW_DEV_SEAL=false

# URL del storage-service (E06 Inc.1 → E07): destino del XML firmado del índice.
STORAGE_SERVICE_URL=http://storage-service:8005
