# auth-service environment variables
# Copy to .env and fill in your values — never commit .env

DATABASE_URL=postgresql+asyncpg://orpycamcp:orpycamcp@localhost:5432/orpycamcp_db
REDIS_URL=redis://localhost:6379/0

# Keycloak — introspection and admin operations
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=orpycamcp
KEYCLOAK_CLIENT_ID=auth-service
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# Keycloak client used for Resource Owner Password Credentials grant
# This client must have directAccessGrantsEnabled=true
KEYCLOAK_GATEWAY_CLIENT_ID=api-gateway
KEYCLOAK_GATEWAY_CLIENT_SECRET=change-me-in-production

# Issuer (`iss`) esperado en los tokens. Por defecto se deriva de
# KEYCLOAK_URL + KEYCLOAK_REALM. Sobreescribir SOLO si el `iss` del token no
# coincide con la URL interna (p. ej. tokens emitidos con la URL pública).
# KEYCLOAK_ISSUER=http://localhost:19180/realms/orpycamcp

# JWKS cache TTL in seconds
JWKS_CACHE_TTL=600

# Service
SERVICE_PORT=8001
LOG_LEVEL=info
