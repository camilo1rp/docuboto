# OrpycaMCP — Production Environment Variables
# Copy this to .env and fill in with real values
# SECURITY: Keep .env out of version control!

# ─── Database ───────────────────────────────────────────────────────────────
DB_USER=orpycamcp_prod
DB_PASSWORD=change-me-in-production
DB_NAME=orpycamcp_db

# ─── Redis ──────────────────────────────────────────────────────────────────
# Use a strong, randomly generated password
REDIS_PASSWORD=change-me-in-production

# ─── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ROOT_USER=orpycamcp
MINIO_ROOT_PASSWORD=change-me-in-production

# ─── Keycloak (identity provider) ───────────────────────────────────────────
KEYCLOAK_HOSTNAME=keycloak.yourdomain.com  # Must match DNS and TLS cert
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

# Service-specific Keycloak secrets (from realm config)
KEYCLOAK_API_GATEWAY_SECRET=your-client-secret-here
KEYCLOAK_AUTH_SERVICE_SECRET=your-client-secret-here

# ─── SMTP (Email notifications) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com  # or your mail server
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=app-specific-password
SMTP_FROM_EMAIL=notifications@yourdomain.com

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── Optional: External Logging ──────────────────────────────────────────────
# For production, integrate with centralized logging:
# - Datadog: https://docs.datadoghq.com/containers/docker/
# - ELK Stack: https://www.elastic.co/guide/en/elasticsearch/reference/current/docker.html
# - CloudWatch: https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/aws-properties-logs-loggroup.html

# Example Datadog integration in docker-compose.prod.yml:
# logging:
#   driver: awslogs
#   options:
#     awslogs-group: /ecs/orpycamcp
#     awslogs-region: us-east-1
#     awslogs-stream-prefix: ecs
