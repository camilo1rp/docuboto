# OrpycaMCP — Production Environment Variables
# Copy this to .env and fill in with real values
# SECURITY: Keep .env out of version control!

# ─── Database ───────────────────────────────────────────────────────────────
DB_USER=orpycamcp_prod
DB_PASSWORD=change-me-in-production
DB_NAME=orpycamcp_db

# ─── Redis ──────────────────────────────────────────────────────────────────
# Use a strong, randomly generated password
REDIS_PASSWORD=change-me-in-production

# ─── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ROOT_USER=orpycamcp
MINIO_ROOT_PASSWORD=change-me-in-production

# ─── Keycloak (identity provider) ───────────────────────────────────────────
KEYCLOAK_HOSTNAME=keycloak.yourdomain.com  # Must match DNS and TLS cert
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

# Service-specific Keycloak secrets (from realm config)
KEYCLOAK_API_GATEWAY_SECRET=your-client-secret-here
KEYCLOAK_AUTH_SERVICE_SECRET=your-client-secret-here

# CONTRATO DE ISSUER (importante para cualquier servicio que valide JWT):
#   El `iss` de los tokens es SIEMPRE la URL pública por la que el navegador hace
#   login. En PROD esa URL es https://${KEYCLOAK_HOSTNAME} y, como Keycloak corre
#   con --hostname-strict=true --hostname=${KEYCLOAK_HOSTNAME}, navegador y
#   servicios usan el MISMO host: expected_issuer se deriva de KEYCLOAK_URL y NO
#   hace falta override. En DEV (docker-compose.yml) sí hay split (navegador
#   localhost:19180 ↔ red keycloak:8080), por eso allí se setea KEYCLOAK_ISSUER.
#   REGLA: si añades un servicio que haga jwt.decode directamente (hoy: auth-service
#   y signature-service), su `expected_issuer` DEBE igualar al `iss` real de los
#   tokens, o rechazará todo (fail-closed). Verifícalo al desplegar.

# ─── Hostnames públicos (detrás del reverse proxy / TLS) ─────────────────────
# Deben resolver por DNS y coincidir con el certificado TLS del reverse proxy.
FRONTEND_HOSTNAME=app.yourdomain.com       # SSR: ORIGIN y redirect_uri del login
API_PUBLIC_HOSTNAME=api.yourdomain.com     # api-gateway público que ve el navegador

# ─── Secretos de servicio ────────────────────────────────────────────────────
# Firma electrónica (E06): clave del sellado HMAC. Generar aleatoria y rotar.
SIGNATURE_SECRET=change-me-in-production
# Conocimiento (E21): token compartido para ingesta interna. Si queda vacío, la
# ingesta es fail-closed (rechaza todo /ingest) — D-02 / RF-SEG-08.
KNOWLEDGE_INTERNAL_TOKEN=change-me-in-production

# ─── Tokens servicio-a-servicio (D-02) ───────────────────────────────────────
# NO son opcionales y NO fallan de forma visible: los endpoints que protegen son
# fail-closed, así que un valor ausente no rompe el arranque — rompe la descarga
# de anexos, el OTP del segundo factor, la firma personal, el AIP y el sellado
# del índice, cada uno con su propio 401/503. Cada token es un secreto ÚNICO
# compartido por exactamente dos servicios (emisor y receptor):
#
#   STORAGE_INTERNAL_TOKEN      document, archive, signature  →  storage
#   DOCUMENT_INTERNAL_TOKEN     archive                       →  document
#   NOTIFICATION_INTERNAL_TOKEN signature                     →  notification
#   SIGNATURE_INTERNAL_TOKEN    archive                       →  signature
#   SIGNING_KEY_INTERNAL_TOKEN  signature                     →  auth
#
# Generar cada uno por separado:  openssl rand -hex 32
STORAGE_INTERNAL_TOKEN=change-me-in-production
DOCUMENT_INTERNAL_TOKEN=change-me-in-production
NOTIFICATION_INTERNAL_TOKEN=change-me-in-production
SIGNATURE_INTERNAL_TOKEN=change-me-in-production
SIGNING_KEY_INTERNAL_TOKEN=change-me-in-production

# ─── Claves de cifrado en reposo (KEK) ───────────────────────────────────────
# base64 de 32 bytes cada una (AES-256), secretos DISTINTOS entre sí y distintos
# de SIGNATURE_SECRET. Generar:  openssl rand -base64 32
#
# ATENCIÓN AL RESPALDO: si pierdes TOTP_ENCRYPTION_KEY, todos los segundos
# factores enrolados quedan ilegibles y hay que re-enrolar a la plantilla entera.
# Si pierdes SIGNING_KEY_ENCRYPTION_KEY, las claves privadas de firma personal
# custodiadas son irrecuperables. Van al mismo sitio que el respaldo de la BD,
# y con la misma disciplina.
TOTP_ENCRYPTION_KEY=
SIGNING_KEY_ENCRYPTION_KEY=

# ─── Sello institucional XAdES (E06) — opcional, con defaults seguros ────────
# SIGNER_ALLOW_DEV_SEAL / TSA_ALLOW_DEV_SEAL NO aparecen aquí a propósito: en
# producción un tenant sin sello propio debe fallar cerrado, no firmar con el par
# compartido de desarrollo. El material va en secrets/signing/<slug>/ y
# secrets/tsa/, montados en solo-lectura.
# SIGNER_PROVIDER=xades_local
# SIGNER_TIMESTAMP_ENABLED=true
# TSA_URL=
# SIGNER_LT_ENABLED=false
# SIGNER_OCSP_ENABLED=true

# ─── SMTP (Email notifications) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com  # or your mail server
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=app-specific-password
SMTP_FROM_EMAIL=notifications@yourdomain.com

# ─── Red: intermediarios de confianza ────────────────────────────────────────
# CSV de CIDR de los saltos que SÍ pueden escribir `X-Forwarded-For`: la subred
# Docker (donde vive el SSR) y el reverse proxy si está fuera de ella. Vacío =
# la cabecera se ignora y todo el tráfico comparte una sola IP a efectos de
# limitación de tasa; un valor de más deja que el cliente elija su identidad de
# red, que es la que se sella en el audit_log.
TRUSTED_PROXIES=172.20.0.0/16

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── Optional: External Logging ──────────────────────────────────────────────
# For production, integrate with centralized logging:
# - Datadog: https://docs.datadoghq.com/containers/docker/
# - ELK Stack: https://www.elastic.co/guide/en/elasticsearch/reference/current/docker.html
# - CloudWatch: https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/aws-properties-logs-loggroup.html

# Example Datadog integration in docker-compose.prod.yml:
# logging:
#   driver: awslogs
#   options:
#     awslogs-group: /ecs/orpycamcp
#     awslogs-region: us-east-1
#     awslogs-stream-prefix: ecs

# Firma del sobre de eventos (Redis Streams). Sin este secreto, los consumidores
# NO verifican el origen del evento, y quien pueda escribir en Redis puede
# ordenar efectos sobre cualquier entidad alojada: el tenant destino viaja en el
# propio sobre. Debe ser el MISMO en todos los servicios y distinto del resto.
EVENT_SIGNING_SECRET=change-me-in-production

# Custodia de las credenciales de los buzones institucionales (IMAP/SMTP). Sin
# esta clave el servicio arranca pero NO puede descifrar lo que guardó: la
# ingesta de correo queda muerta. No estaba en ningún manifiesto de producción.
EMAIL_ENCRYPTION_KEY=

# Firma de las propuestas de escritura del asistente. El manifiesto de
# producción ya la exige y aborta el arranque si falta; faltaba aquí, así que
# quien preparaba el despliegue no tenía forma de saber que hacía falta.
MCP_PROPOSAL_SECRET=change-me-in-production
# Secreto anterior, solo durante una rotación. Vacío el resto del tiempo.
MCP_PROPOSAL_SECRET_PREVIOUS=

# Zona horaria con la que se decide el AÑO del número de radicado y la fecha
# base de los plazos. Colombia es UTC-5: con el valor universal, lo radicado el
# 31 de diciembre por la tarde recibía el número del año siguiente.
TZ_RADICACION=America/Bogota

# ── Reparto de roles de base de datos ───────────────────────────────────────
#
# DB_USER es el rol PROPIETARIO: aplica migraciones, provisiona entidades y crea
# particiones. Postgres lo crea SUPERUSUARIO, y con él las tres capas que
# protegen audit_log no protegen nada — la de privilegios la omite el
# superusuario por definición.
#
# DB_APP_USER es el rol de la APLICACIÓN: lee y escribe filas, y sobre la
# auditoría SOLO puede añadir. Es el que usan los servicios. Actívelo así, con
# un secreto propio, antes de desplegar:
#
#     ALTER ROLE orpycamcp_app LOGIN PASSWORD '<secreto del despliegue>';
#
# tenant-service es la excepción declarada: crea esquemas al dar de alta una
# entidad, así que sigue conectando como propietario.
DB_APP_USER=orpycamcp_app
DB_APP_PASSWORD=change-me-in-production

# ── Respaldo ────────────────────────────────────────────────────────────────
#
# El respaldo contiene, FUERA de la aplicación, lo mismo que el control de
# acceso protege dentro: un radicado reservado se lee abriendo el fichero. Y un
# respaldo viaja — a un NAS, a una cinta, a un proveedor que no tiene ni debe
# tener nivel de acceso sobre esos documentos.
#
# Por eso backup.sh NO continúa sin una decisión explícita. Elija UNA:
#
#   BACKUP_GPG_RECIPIENT   cifra el volcado y el almacén a esa clave pública
#   BACKUP_PLANO=1         acepta dejarlo en claro, a sabiendas
#
# La restauración descifra sola: no hay que hacer nada distinto.
BACKUP_GPG_RECIPIENT=
# BACKUP_PLANO=1

# Firma de las cabeceras de identidad que el gateway inyecta hacia los servicios.
#
# Sin este secreto, la identidad viaja como texto plano: quién eres, de qué
# entidad y con qué roles. Desde fuera no se puede forjar —el gateway no reenvía
# esas cabeceras si vienen del cliente— pero dentro de la red de contenedores
# cualquiera que alcance el puerto de un servicio podía hablarle diciendo ser
# quien quisiera. Debe ser el MISMO en todos los servicios y distinto del resto.
IDENTITY_SIGNING_SECRET=change-me-in-production

# Sella (HMAC-SHA256) las entradas de la caché de validación del token en Redis.
# EXCLUSIVO del api-gateway: no lo compartas con otros servicios ni lo reutilices
# de otro secreto. Sin él la caché queda apagada (cada petición consulta a auth).
AUTH_CACHE_MAC_SECRET=change-me-in-production
