# ──────────────────────────────────────────────────────────────────────────────
# OrpycaMCP — plantilla de reverse proxy (nginx)
#
# La guía de despliegue (docs/es/deployment.md) manda desde siempre copiar este
# archivo… y el archivo no existía. Quien seguía la guía al pie de la letra se
# quedaba sin proxy y publicaba el SSR y el gateway a pelo, sin TLS, sin HSTS y
# sin las cabeceras `X-Forwarded-*` de las que dependen tres cosas del sistema:
#
#   1. `ORIGIN` / `PROTOCOL_HEADER` / `HOST_HEADER` del frontend SSR. Sin
#      `X-Forwarded-Proto`, adapter-node cree que el origen es `http://` y arma
#      un `redirect_uri` que Keycloak rechaza: el login PKCE no funciona.
#   2. `TRUSTED_PROXIES` del gateway. Sin `X-Forwarded-For`, todo el tráfico
#      comparte la IP del contenedor del SSR — la limitación por IP protege a
#      todos como si fueran uno, y la IP que se sella en `audit_log` (registro
#      con valor probatorio) es la del proxy, no la del ciudadano.
#   3. Las descargas grandes (anexos, ZIP de expediente, AIP). Con el buffering
#      por defecto, nginx materializa la respuesta antes de reenviarla y tira
#      por tierra el flujo por trozos que el gateway implementa.
#
# CÓMO USARLA
#   sudo cp infra/nginx.conf.example /etc/nginx/sites-available/orpyca
#   # sustituye los tres <dominio...> y las rutas de los certificados
#   sudo ln -s /etc/nginx/sites-available/orpyca /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Los certificados se obtienen aparte (certbot, o los que emita la entidad).
# La terminación TLS y la segmentación de red son responsabilidad del operador;
# lo que este repositorio entrega es esta plantilla.
# ──────────────────────────────────────────────────────────────────────────────

# Tope de subida. Debe coincidir con `MAX_REQUEST_BODY_BYTES` del gateway y con
# `BODY_SIZE_LIMIT` del frontend (512 MiB): es el tamaño del ZIP de importación
# interoperable, la carga legítima más grande del sistema. Si nginx lo deja más
# bajo, la subida muere aquí con un 413 y los topes de la aplicación no llegan a
# opinar — y el mensaje de error no dice quién la cortó.
client_max_body_size 512M;

# Cabeceras que viajan a TODO backend. `X-Forwarded-For` se ACUMULA con
# `proxy_add_x_forwarded_for` en vez de sobrescribirse: el gateway resuelve la IP
# real caminando la cadena desde el final hacia atrás por saltos de confianza
# (services/api-gateway/app/core/client_ip.py), y con un valor plano no puede.
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;

proxy_http_version 1.1;

# ─── Redirección a HTTPS ──────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name <dominio-app> <dominio-api>;

    # Único hueco sin redirigir: la validación de certificados de Let's Encrypt.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── Frontend (SvelteKit SSR) ─────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <dominio-app>;

    ssl_certificate     /etc/letsencrypt/live/<dominio-app>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<dominio-app>/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    # HSTS. Va aquí y no en la aplicación a propósito: es una promesa sobre el
    # DOMINIO ENTERO, y quien puede hacerla es quien termina el TLS. El frontend
    # no la emite justamente por esto — si la emitiera un despliegue servido por
    # http, dejaría el dominio inalcanzable durante un año.
    #
    # `includeSubDomains` afecta a TODO subdominio: actívalo solo cuando todos
    # sirvan HTTPS. `preload` es prácticamente irreversible; no lo añadas sin
    # entender que sacar un dominio de la lista tarda meses.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Las demás cabeceras de seguridad (CSP, nosniff, referrer-policy,
    # X-Frame-Options, permissions-policy) las emite el propio SSR
    # (frontend/src/lib/server/securityHeaders.js y la CSP de svelte.config.js),
    # que es donde se sabe qué necesita cada respuesta. No las dupliques aquí:
    # `add_header` en nginx NO sustituye la del backend, y dos valores distintos
    # de la misma cabecera dan un comportamiento que depende del navegador.

    location / {
        proxy_pass http://127.0.0.1:3000;

        # El SSR emite HTML en flujo; con buffering, la página no empieza a
        # pintarse hasta que termina de generarse entera.
        proxy_buffering off;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }
}

# ─── API pública (gateway) ────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <dominio-api>;

    ssl_certificate     /etc/letsencrypt/live/<dominio-api>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<dominio-api>/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # La sonda de disponibilidad es pública para el balanceador, no para
    # internet: enumera el estado de los once servicios río abajo. El gateway ya
    # reduce ese estado a ok/error/unreachable para no publicar la topología,
    # pero el número de servicios y sus nombres siguen siendo información que
    # nadie de fuera necesita.
    location = /health/ready {
        allow 127.0.0.1;
        allow 172.20.0.0/16;   # red Docker del despliegue
        deny  all;
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;

        # IMPRESCINDIBLE para las descargas: anexos, ZIP de expediente, AIP y
        # actas se sirven por trozos desde storage a través del gateway. Con
        # buffering, nginx los junta enteros en disco antes de mandar el primer
        # byte — vuelve a materializar lo que el bloque 4 dejó de materializar.
        proxy_buffering off;
        proxy_request_buffering off;

        proxy_connect_timeout 5s;
        proxy_send_timeout    120s;
        # 120 s cubre las importaciones y exportaciones grandes. El asistente
        # conversacional (E18) tiene su propio timeout de 180 s en el gateway;
        # si lo publicas por aquí, sube este valor por encima o el proxy cortará
        # la respuesta antes de que el gateway se dé por vencido — y el usuario
        # verá un 504 en vez del error real.
        proxy_read_timeout    120s;
    }
}
