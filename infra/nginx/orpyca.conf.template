# ──────────────────────────────────────────────────────────────────────────────
# OrpycaMCP — reverse proxy de producción (servicio `edge` de
# infra/docker-compose.prod.yml, ADR-033)
#
# Es una PLANTILLA de la imagen oficial de nginx: al arrancar, su envsubst
# sustituye ${FRONTEND_HOSTNAME} y ${API_PUBLIC_HOSTNAME}
# (NGINX_ENVSUBST_FILTER deja intactos los `$host`, `$remote_addr`... de nginx) y
# escribe /etc/nginx/conf.d/orpyca.conf. No hay nada que copiar ni editar: los
# dos dominios salen del mismo `.env` que el resto de la pila.
#
# Por qué existe cada pieza (la lección de la plantilla anterior, que solo servía
# para nginx en el anfitrión y dejaba la pila inalcanzable):
#
#   1. `ORIGIN` / `PROTOCOL_HEADER` / `HOST_HEADER` del frontend SSR. Sin
#      `X-Forwarded-Proto`, adapter-node cree que el origen es `http://` y
#      rechaza por CSRF el formulario de inicio de sesión.
#   2. `TRUSTED_PROXIES` de la app. `X-Forwarded-For` se ACUMULA; la IP que se
#      sella en `audit_log` y en la constancia de la ventanilla sale de esa
#      cadena. Ver "TRUSTED_PROXIES" en docs/es/deployment.md: el gateway de la
#      red Docker (172.20.0.1) NO es de confianza, a propósito.
#   3. Las descargas grandes (anexos, ZIP de expediente, AIP): sin desactivar el
#      buffering, nginx las materializa antes de reenviarlas.
#   4. El emisor de identidad (ADR-048) vive en la app: `/.well-known/*` y
#      `/oauth/token` salen por el dominio del API, que es el `iss` de los JWT.
#
# TLS: los certificados los emite certbot en el anfitrión (/etc/letsencrypt) y
# se montan de solo lectura. Primera emisión: `certbot certonly --standalone`
# ANTES del primer `up` (el puerto 80 aún está libre); renovaciones por webroot.
# ──────────────────────────────────────────────────────────────────────────────

# Tope de subida. Debe coincidir con `BODY_SIZE_LIMIT` del frontend (512 MiB): es el tamaño del ZIP de importación
# interoperable, la carga legítima más grande del sistema. Si nginx lo deja más
# bajo, la subida muere aquí con un 413 y los topes de la aplicación no llegan a
# opinar — y el mensaje de error no dice quién la cortó.
client_max_body_size 512M;

# ─── Límite de tasa (ADR-047: antes en el api-gateway) ────────────────────────
# Por IP, en memoria compartida de nginx; sin almacén externo. Los presupuestos son los que
# tenía el gateway por minuto. `$binary_remote_addr` es la IP que ve `edge`: con
# el proxy de usuario de Docker activo es la del puente para todo cliente (ver
# "TRUSTED_PROXIES" en docs/es/deployment.md); entonces el cubo por IP se vuelve
# global y conviene publicar el puerto con `userland-proxy: false`.
#
# - api_ip:     todo lo que entra (1200/min por IP).
# - login_ip:   login, refresh, cambio de contraseña, /oauth/token y el login del SSR (20/min por IP).
# - radicacion: altas anónimas — POST a ventanilla/PQRS y al formulario público
#               del SSR (5/min por IP). Clave vacía = sin límite: solo POST cuenta.
# - cosecha_ip: OAI-PMH y CMIS públicos, que asientan en la cadena de auditoría
#               (30/min por IP).
map $request_method $radicacion_clave {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $binary_remote_addr zone=api_ip:10m     rate=20r/s;
limit_req_zone $binary_remote_addr zone=login_ip:10m   rate=20r/m;
limit_req_zone $radicacion_clave   zone=radicacion:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=cosecha_ip:10m rate=30r/m;
limit_req_status 429;
limit_req_log_level warn;

# Cabeceras que viajan a TODO backend. `X-Forwarded-For` se ACUMULA con
# `proxy_add_x_forwarded_for` en vez de sobrescribirse: la app resuelve la IP
# real caminando la cadena desde el final hacia atrás por saltos de confianza
# (shared/orpycamcp_common/client_ip.py), y con un valor plano no puede.
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;

proxy_http_version 1.1;

# DNS interno de Docker. Con `proxy_pass` a una VARIABLE, nginx resuelve el nombre
# en cada petición (valid=10s) y reparte entre las réplicas de frontend y app;
# con un nombre literal lo resolvería una sola vez al arrancar y se quedaría con
# la IP de una réplica (o fallaría al arrancar si aún no existe).
resolver 127.0.0.11 valid=10s ipv6=off;

# ─── Redirección a HTTPS ──────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${FRONTEND_HOSTNAME} ${API_PUBLIC_HOSTNAME};

    # Único hueco sin redirigir: la validación de certificados de Let's Encrypt.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── Frontend (SvelteKit SSR) ─────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${FRONTEND_HOSTNAME};

    ssl_certificate     /etc/letsencrypt/live/${FRONTEND_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FRONTEND_HOSTNAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    # HSTS. Va aquí y no en la aplicación a propósito: es una promesa sobre el
    # DOMINIO ENTERO, y quien puede hacerla es quien termina el TLS. `preload` es
    # prácticamente irreversible; no lo añadas sin entenderlo.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Las demás cabeceras de seguridad (CSP, nosniff, referrer-policy,
    # X-Frame-Options, permissions-policy) las emite el propio SSR
    # (frontend/src/lib/server/securityHeaders.js y la CSP de svelte.config.js).
    # No las dupliques aquí: dos valores distintos de la misma cabecera dan un
    # comportamiento que depende del navegador.

    location /login {
        limit_req zone=login_ip burst=10 nodelay;
        set $frontend http://frontend:3000;
        proxy_pass $frontend;
    }

    location /radicacion {
        limit_req zone=radicacion burst=3 nodelay;
        limit_req zone=api_ip burst=200 nodelay;
        set $frontend http://frontend:3000;
        proxy_pass $frontend;
    }

    location / {
        limit_req zone=api_ip burst=200 nodelay;
        set $frontend http://frontend:3000;
        proxy_pass $frontend;

        # El SSR emite HTML en flujo; con buffering, la página no empieza a
        # pintarse hasta que termina de generarse entera.
        proxy_buffering off;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }
}

# ─── API pública (app) ────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_PUBLIC_HOSTNAME};

    ssl_certificate     /etc/letsencrypt/live/${API_PUBLIC_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_PUBLIC_HOSTNAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # La sonda de disponibilidad enumera el estado de los servicios río abajo: no es
    # para internet. SOLO la alcanza el propio contenedor `edge` (127.0.0.1). La IP
    # del gateway de la red Docker (172.20.0.1) NO se admite: es la que ve nginx para
    # todo lo que entra por el puerto publicado (docker-proxy), es decir, también la de
    # cualquier cliente de internet. Sondeo desde el anfitrión:
    #   docker exec <edge> wget --no-check-certificate -qO- \
    #       --header 'Host: <API_PUBLIC_HOSTNAME>' https://127.0.0.1/health/ready
    location = /health/ready {
        allow 127.0.0.1;
        deny  all;
        set $app http://app:8000;
        proxy_pass $app;
    }

    # `/metrics` (C18, ADR-041) es de Prometheus, por la red interna, directo al puerto
    # de la app: desde internet NO existe.
    location = /metrics {
        return 404;
    }

    location /metrics/ {
        return 404;
    }

    location ~ ^/(api/v1/auth/(login|refresh|password)|oauth/token)/?$ {
        limit_req zone=login_ip burst=10 nodelay;
        set $app http://app:8000;
        proxy_pass $app;
    }

    location ~ ^/api/v1/public/[^/]+/(pqrs|ventanilla)/?$ {
        limit_req zone=radicacion burst=3 nodelay;
        set $app http://app:8000;
        proxy_pass $app;
    }

    location ~ ^/api/v1/public/(oai|cmis)/ {
        limit_req zone=cosecha_ip burst=10 nodelay;
        set $app http://app:8000;
        proxy_pass $app;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    location / {
        limit_req zone=api_ip burst=200 nodelay;
        set $app http://app:8000;
        proxy_pass $app;

        # IMPRESCINDIBLE para las descargas: anexos, ZIP de expediente, AIP y
        # actas se sirven por trozos.
        proxy_buffering off;
        proxy_request_buffering off;

        proxy_connect_timeout 5s;
        proxy_send_timeout    120s;
        # 120 s cubre las importaciones y exportaciones grandes.
        proxy_read_timeout    120s;
    }
}
