{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EscribirRetenerYLeerTrabajo",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObjectRetention",
        "s3:GetObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:GetObjectLegalHold",
        "s3:ListBucket",
        "s3:CreateBucket",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketVersioning"
      ],
      "Resource": ["arn:aws:s3:::*", "arn:aws:s3:::*/*"]
    },
    {
      "Sid": "SinBorrarPreservacion",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::orpycamcp-*-preservation",
        "arn:aws:s3:::orpycamcp-*-preservation/*",
        "arn:aws:s3:::orpycamcp-*-preservation-replica",
        "arn:aws:s3:::orpycamcp-*-preservation-replica/*"
      ]
    },
    {
      "Sid": "SinCambiarElCubo",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketVersioning",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutObjectLockConfiguration"
      ],
      "Resource": ["arn:aws:s3:::*", "arn:aws:s3:::*/*"]
    }
  ]
}
