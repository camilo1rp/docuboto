{
  "name": "orpyca-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend de OrpycaMCP — SvelteKit (SSR), cliente del api-gateway. Stack alineado con sgdINTI (ver ADR-011). ESTADO: planificado, aún no implementado.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@sveltejs/kit": "2.22.0",
    "bulma": "^0.9.4",
    "marked": "^15.0.0",
    "svelte": "^4.2.0",
    "svelte-dnd-action": "^0.9.69"
  },
  "optionalDependencies": {
    "@hocuspocus/provider": "^2.10.0",
    "@tiptap/core": "3.20.2",
    "@tiptap/pm": "3.20.2",
    "@tiptap/starter-kit": "3.20.2",
    "@tiptap/y-tiptap": "^3.0.3",
    "altcha": "^2.3.0",
    "survey-core": "^2.0.0",
    "survey-js-ui": "^2.0.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-node": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^4.2.3",
    "@types/node": "^20.0.0",
    "eslint": "^8.28.0",
    "eslint-plugin-svelte": "^2.35.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.1.0",
    "sass": "^1.101.0",
    "svelte-check": "^3.6.0",
    "svelte-eslint-parser": "^0.33.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
