# OrpycaMCP Frontend — Variables de entorno
# Copiar a .env y ajustar para el entorno.
# Las variables PUBLIC_* son visibles en el cliente (expuestas por Vite/SvelteKit).
# Nunca poner secretos en PUBLIC_*.

# URL del api-gateway (todo el tráfico pasa por aquí — ADR-011)
PUBLIC_API_URL=http://localhost:19080

# URL de Keycloak (para construir endpoints de autorización/token/logout)
PUBLIC_KEYCLOAK_URL=http://localhost:19180

# Puerto del servidor Node SSR (adapter-node)
# PORT=3000
