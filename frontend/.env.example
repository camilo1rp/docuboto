# OrpycaMCP Frontend — Variables de entorno
# Copiar a .env y ajustar para el entorno local.
#
# VARIABLES PÚBLICAS (PUBLIC_*): visibles en el bundle de cliente (expuestas por
# SvelteKit vía $env/dynamic/public). Solo URLs que el NAVEGADOR del usuario
# necesita para llegar al gateway y a Keycloak. Nunca poner secretos aquí.
#
# VARIABLES INTERNAS: privadas ($env/dynamic/private), solo accesibles en el
# servidor SSR. Son las URLs que el CONTENEDOR DOCKER usa para alcanzar los
# servicios internos por nombre de red. Nunca se envían al cliente.

# ---------------------------------------------------------------------------
# URLs PÚBLICAS — usadas por el navegador del usuario
# ---------------------------------------------------------------------------

# URL del api-gateway accesible desde el navegador del usuario
PUBLIC_API_URL=http://localhost:19080

# URL de Keycloak accesible desde el navegador del usuario
# (también determina el issuer `iss` de los tokens JWT)
PUBLIC_KEYCLOAK_URL=http://localhost:19180

# ---------------------------------------------------------------------------
# URLs INTERNAS — usadas por el servidor SSR dentro de la red Docker
# (no llegan al navegador; usan nombres de servicio Docker)
# ---------------------------------------------------------------------------

# URL interna del api-gateway (nombre de servicio Docker)
INTERNAL_API_URL=http://api-gateway:8080

# URL interna de Keycloak (nombre de servicio Docker)
# Usada para token exchange, refresh y revocación back-channel.
# El `iss` de los tokens sigue siendo PUBLIC_KEYCLOAK_URL (KC_HOSTNAME_URL).
INTERNAL_KEYCLOAK_URL=http://keycloak:8080

# ---------------------------------------------------------------------------
# Otros
# ---------------------------------------------------------------------------

# Puerto del servidor Node SSR (adapter-node)
# PORT=3000
